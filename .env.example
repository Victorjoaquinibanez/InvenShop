# Copiar este archivo como .env y completar los valores (el .env NO se sube a git)
# Generar una clave nueva con:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=cambiar-por-una-clave-larga-y-secreta
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
SQLITE_NOMBRE=db.sqlite3
SEGURO_HTTPS=False
# Solo para probar con DEBUG=False en la computadora local (sirve las fotos de media/).
# Además hay que levantar el servidor con:  python manage.py runserver --insecure
SERVIR_MEDIA=False
